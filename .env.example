# local = interprete deterministico incluso; openai = Responses API
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DATABASE_PATH=data/travel_companion.db
APP_TIMEZONE=Europe/Zurich
MONITOR_INTERVAL_SECONDS=3600
AI_MONTHLY_BUDGET_USD=4.50
# Tariffe USD per milione di token; aggiornarle quando cambia il modello/prezzo.
AI_INPUT_PRICE_PER_MILLION=0.25
AI_CACHED_INPUT_PRICE_PER_MILLION=0.025
AI_OUTPUT_PRICE_PER_MILLION=2.00
